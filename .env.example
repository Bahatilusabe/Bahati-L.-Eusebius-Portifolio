# Copy to .env for local development. Never commit .env files.

# PostgreSQL connection used by Prisma. Keep its password in this environment
# variable; do not put credentials in source code.
DATABASE_URL=
DATABASE_SHADOW_URL=
POSTGRES_USER=prisma
POSTGRES_PASSWORD=

# Generate a unique secret with: openssl rand -base64 48
# Must contain at least 32 characters.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Required for seeding or local file-backed admin authentication.
# Use a unique admin email and a strong password of at least 12 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public site URL and backend settings (not secrets).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PORT=4000
CONTACT_RATE_LIMIT_WINDOW_MS=60000
CONTACT_RATE_LIMIT_MAX=6
DATA_CACHE_TTL=30

# Optional Cloudinary credentials.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
